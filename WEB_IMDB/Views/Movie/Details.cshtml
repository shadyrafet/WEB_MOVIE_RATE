@model WEB_IMDB.Movie

@{
    ViewBag.Title = "Details ";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-md-3">
        <img src = "data:image/*;base64,@Convert.ToBase64String(Model.Image)" class = "img-thumbnail" alt = "@Model.Title"/>
    </div>
    <div class="col-md-7">
        <div class="d-flex justify-content-between">
            <h3>@Model.Title</h3>
            <span class="mt-2">
                <i class="bi bi-star-fill text-warning"></i>
                <span class="text-muted">@Model.Rate.ToString("0.00")</span>
            </span> 
        </div>
        <div class="">
          <span class="text-muted " >
              <i class="bi bi-calendar-week"></i>
              @Model.Year.ToString()
          </span>
          <span class="text-muted mr-3">
            <i class="bi bi-film mr-3"></i>
            @Model.Genre.Name
          </span>
          <p>@Model.StoryLine</p>
       </div>
   </div>
    
</div>