@model IEnumerable<Movie>
@{
     ViewData["Title "] = "Movies";
}
<h2>
     Movies
     <i class="bi bi-film"></i>
</h2>
<a class="btn btn-primary" asp-action="Create">
     <i class="bi bi-bookmark-plus-fill"></i>
     Add Movie
</a>
<div class="mt-4">
     @if (!Model.Any())
     {
          <div class="alert alert-warning" role = "alert">
               No movie found
               <i class="bi bi-exclamation-triangle-fill"></i>
          </div>

     }
     else
     {
          <div class="row">
               @foreach (Movie movie in Model)
               {
                    <div class="col-md-12 mb-3" >
                         <div class="row g-0">
                              <div class="col-md-2 image" style="background-image: url(data:image/*;base64,@(Convert.ToBase64String(movie.Image)))">
                              </div>
                              <div class = "col-md-10">
                                   <div class="card-body">
                                        <h5 class="card-title">@movie.Title @movie.Year </h5>
                                        <p class="card-text text-justify">@(movie.StoryLine.Length>500?$"{movie.StoryLine.Substring(0,500)}....":movie.StoryLine)</p>
                                   </div>
                                   <div class="d-flex justify-content-between">
                                        <p class="card-text mb-0 mt-3">
                                             <i class="bi bi-star-fill text-warning"></i>
                                             <small class="text-body-secondary">
                                                  @movie.Rate.ToString("0.00")
                                             </small>
                                        </p>
                                        <div>
                                             <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-secondary">
                                                  <i class = "bi bi-camera-reels"></i>
                                                  Details
                                             </a>
                                             <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-outline-primary">
                                                  <i class = "bi bi-pencil"></i>
                                                  Edit
                                             </a>
                                             <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-outline-danger">
                                                  <i class = "bi bi-trash"></i>
                                                  Delete
                                             </a>
                                        </div>
                                   </div>
                              </div>
                         </div>
                    </div>
               }
          </div>
     }
</div>