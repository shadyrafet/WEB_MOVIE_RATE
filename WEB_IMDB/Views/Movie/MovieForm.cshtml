@model WEB_IMDB.ViewModel.MovieFromViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Movie" : "Create Movie";
}
@section Styles
{
    <link rel="stylesheet" href="~/lib/bootstrap-datepicker/css/bootstrap-datepicker3.min.css"/>
}
<h2>@(isEdit ? "Edit Movie" : "Create Movie")</h2>
<section>
    <div class="col-md-4"> 
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label class="text-muted" asp-for="Title"></label>
                <input type="text" class="form-control" asp-for="Title" maxlength="250"/>
                <span asp-validation-for="Title" class = "text-danger"></span>
            </div>
            <div class="form-group">
                <label class="text-muted" asp-for="GenreID"></label>
                <select class="form-control" asp-for="GenreID" asp-items="@(new SelectList(Model.Genres, "Id","Name"))">
                    <option></option>
                </select>
                <span asp-validation-for="GenreID" class = "text-danger"></span>
            </div>
            <div class="form-group w-50" >
                <label class="text-muted" asp-for="Year"></label>
                <input type="text" class="form-control" asp-for="Year"/>
                <span asp-validation-for="Year" class = "text-danger"></span>
            </div>
            <div class="form-group w-50" >
                <label class="text-muted" asp-for="Rate"></label>
                <input type="number" class="form-control" asp-for="Rate"/>
                <span asp-validation-for="Rate" class = "text-danger"></span>
            </div>
            <div class="form-group " >
                <label class="text-muted" asp-for="StoryLine"></label>
                <textarea class="form-control" asp-for="StoryLine" maxlength="2500" rows="4"> </textarea>
                <span asp-validation-for="StoryLine" class = "text-danger"></span>
            </div>
            
            <div class="form-group">
                <label class="text-muted" asp-for="Image"></label>
                <input type="file" class="form-control" asp-for="Image" accept="image/*"/>
                @if(isEdit){
                    <small class="form-text text-muted">Leave empty to keep the current image.</small>
                }else{
                    <span asp-validation-for="Image" class="text-danger"></span>
                }
            </div>
            
            <button type="submit" class = "btn btn-primary mt-4" >Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary mt-4" >
                Cancel
            </a>


        </form>
    </div>
    <div class="col-md-4">
        <div id="ImagePreview" class="@(isEdit ? "" : "d-none")">
            @if (isEdit && Model.Image is WEB_IMDB.Helpers.ByteArrayFormFile bytes)
            {
                <img src="data:image/*;base64,@(Convert.ToBase64String(bytes.GetBytes()))" alt="Poster" class="img-thumbnail"/>
            }
            else
            {
                <img src="" alt="Poster" class="img-thumbnail"/>
            }
        </div>

    </div>
</section>
@section Scripts
{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");};
    <script src="~/lib/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script>
        $(document).ready( function(){
            $('input[type="file"]').on('change', function(){
                
                var preview = $('#ImagePreview');
                preview.removeClass('d-none');
                var image = window.URL.createObjectURL(this.files[0]);
                preview.find('img').attr('src', image);
            })
           

        });
        $('#Year').datepicker({
            format: 'yyyy',
            viewMode: 'years',
            minViewMode: 'years',
            autoclose: true,
            startDate:new Date('1980-01-01'),
            endDate: new Date(),
            
        });
    </script>
}

